# --------------------------------------------------------------------------- #
# HappyRobot FDE Case — environment configuration
#
# Copy this file to `.env` (which is gitignored) and fill in the secrets.
#   cp .env.example .env
#
# This file is read by:
#   - the FastAPI backend via pydantic-settings (local `make dev-api`)
#   - docker-compose via the `${VAR}` interpolation in docker-compose.yml
#
# In PRODUCTION (Fly.io), these values come from Fly secrets, NOT from this
# file. Fly secrets take precedence over the .env file at runtime.
# --------------------------------------------------------------------------- #

# === Required secrets ====================================================== #

# Shared secret for the X-API-Key header on every /api/* endpoint.
# Generate a strong one: `openssl rand -hex 24`
API_KEY=replace-me-with-openssl-rand-hex-24

# FMCSA QCMobile webKey (the brief calls it "FMCSA API key").
# Get one at https://mobile.fmcsa.dot.gov/QCDevsite/getStarted
FMCSA_API_KEY=replace-me-with-your-fmcsa-webkey


# === Optional configuration (sensible defaults shown) ====================== #

# `dev` | `staging` | `production` — tagged into structured logs.
ENVIRONMENT=dev

# SQLite by default; for Postgres use e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated origins, or `*` to allow all (fine for the demo).
# In prod, restrict to your dashboard origin.
CORS_ORIGINS=*

# Negotiation policy (server-enforced; agent cannot promise below the floor)
NEGOTIATION_FLOOR_PCT=0.92
NEGOTIATION_CEILING_PCT=1.10
NEGOTIATION_MAX_ROUNDS=3

# FMCSA client tunables
FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
FMCSA_CACHE_TTL_SECONDS=3600

# slowapi rate limit on /api/verify_carrier
RATE_LIMIT_VERIFY=30/minute
